    <p class="assign-lead">For assignments, credentials and editorial work</p>
    <div class="assign-mail">
      <a class="big-mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <button class="copy" type="button" data-copy="{{ site.email }}">Copy address</button>
    </div>
  </div>
</section>
